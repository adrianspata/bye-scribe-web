# Database connection URL (PostgreSQL runtime via transaction pooler)
DATABASE_URL=

# Database migration URL (PostgreSQL direct connection or session pooler for DDL/migrations)
DATABASE_MIGRATION_URL=


# Data source mode: "fixtures" (for local dev/tests) or "postgres" (for production/staging)
BYESCRIBE_DATA_SOURCE=fixtures

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Summa App Store URL
NEXT_PUBLIC_SUMMA_APP_STORE_URL=
